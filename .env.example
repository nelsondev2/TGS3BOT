# ===== Telegram =====
# https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# Modo bot oficial (único modo soportado):
TG_BOT_TOKEN=

# Sesión de BOT pre-generada (opcional; tiene prioridad sobre TG_BOT_TOKEN).
# Genera este string con: python scripts/generate_bot_session.py
# No uses sesiones de cuentas personales: el bot las rechaza al arrancar.
TG_SESSION_STRING=

# CSV de IDs autorizados. Vacío = todos.
ALLOWED_TG_IDS=

# ===== Servidor =====
PORT=10000

# ===== Descarga =====
DOWNLOAD_PATH=/tmp/tg_uploads

# 0 = SIN límite de tamaño.
# Telegram impone su propio tope: 2 GB en bots y 4 GB en premium.
MAX_FILE_SIZE_MB=0

# 0 = sin comprobación previa al enviar a Telegram (Telegram decide).
TG_UPLOAD_LIMIT_MB=0

CHUNK_SIZE_MB=8
# Tiempos máximos (segundos) para archivos grandes; no son límites de tamaño.
DOWNLOAD_TIMEOUT_SECONDS=3600
UPLOAD_TIMEOUT_SECONDS=3600
PARALLEL_URL_DOWNLOAD=1
PARALLEL_URL_PARTS=4
PARALLEL_URL_MIN_SIZE_MB=50

# ===== Comportamiento =====
# 0 = solo URL S3 (ahorra datos en toDus); 1 = también enviar el archivo.
SEND_FILE_VIA_TG=0

# ===== Watchdog =====
WATCHDOG_ENABLED=1
WATCHDOG_LIFETIME=14100

# ===== Seguridad =====
# Bloquea IPs privadas, loopback, CGNAT, link-local y redirecciones a ellas.
SSRF_BLOCK_PRIVATE=1

# ===== S3 =====
S3_ENDPOINT=https://s3.todus.cu
S3_BUCKET=stream
S3_REGION=us-east-1
S3_UNSIGNED=1
S3_ACCESS_KEY=public
S3_SECRET_KEY=public
# Opcional: base pública propia (CDN, dominio, bucket virtual-host).
# Si se define, las URLs serán {S3_PUBLIC_BASE_URL}/{key}
S3_PUBLIC_BASE_URL=

# ===== Logs =====
LOG_LEVEL=INFO
TELETHON_LOG_LEVEL=WARNING
